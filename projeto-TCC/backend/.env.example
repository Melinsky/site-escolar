PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# pglite: banco local persistente, sem instalação adicional.
DB_DRIVER=pglite
# Gerenciamento automático da instalação local Windows: configurado por npm run db:migrate.
# Deixe false para PGlite ou PostgreSQL hospedado externamente.
DB_LOCAL_MANAGED=false
# DATA_DIR=C:/caminho/absoluto/dados-eeafr
# Para PostgreSQL: DB_DRIVER=postgres e DATABASE_URL=postgresql://usuario:senha@localhost:5432/eeafr_database
# DB_SSL=true
# Produção: HTTPS e credenciais obrigatórias no primeiro acesso (senha de pelo menos 12 caracteres).
# ADMIN_EMAIL=admin@sua-escola.com.br
# ADMIN_PASSWORD=
# Em produção: PUBLIC_URL=https://escola.seudominio.com.br
# Secrets de container: DB_PASSWORD_FILE=/run/secrets/postgres_app_password
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password
# CA de PostgreSQL externo: DB_SSL_CA_FILE=/caminho/ca.pem
# SEED_CONTENT=false evita a carga de conteúdo de referência em bancos novos.
# Atrás de exatamente um proxy confiável: TRUST_PROXY=1
